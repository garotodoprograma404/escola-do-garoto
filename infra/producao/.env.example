# Copie para infra/producao/.env (fora do git) e preencha. Veja docs/deploy.md.

# Domínio do site, sem https:// (o DNS precisa apontar para este servidor).
DOMINIO=escola.exemplo.com.br

# Gere cada segredo com: openssl rand -hex 32
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
FILES_SIGNING_SECRET=

# Mercado Pago: configure no painel do admin depois de subir (Configurações → Financeiro).

# E-mail (SMTP): confirmação de conta, recuperação de senha, avisos.
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto (porta 465); false para STARTTLS (587)
SMTP_SECURE=false
# Em produção o e-mail sempre exige TLS (a API recusa subir sem). Deixe em branco/true.
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Escola do Garoto <contato@escola.exemplo.com.br>"

# Hospedagens de imagem externas permitidas no site, separadas por vírgula (opcional).
IMAGE_HOSTS=
