# Copie para infra/demo/.env (fora do git) e preencha. Veja docs/deploy.md.

# Domínio do site, sem https:// (o DNS precisa apontar para este servidor).
DOMINIO=demo.exemplo.com.br

# Gere cada segredo com: openssl rand -hex 32
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
FILES_SIGNING_SECRET=

# Hospedagens de imagem externas permitidas no site, separadas por vírgula (opcional).
IMAGE_HOSTS=

# Pasta do servidor com o conteúdo da demonstração: videos/*.mp4 e imagens/ (capas, avatar, blog, PDF).
DEMO_MIDIA_DIR=/opt/escola-do-garoto-midia

# Senhas das contas de demonstração (16+ caracteres), usadas pelo reset-demo.sh. Gere com:
#   openssl rand -base64 24
SEED_ADMIN_PASSWORD=
SEED_PRODUCER_PASSWORD=
SEED_STUDENT_PASSWORD=
# CNPJ mostrado nos termos (opcional).
DEMO_COMPANY_DOCUMENT=
