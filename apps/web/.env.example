# Copie para apps/web/.env.local
# Endereço da API usado pelo servidor do Next (Server Components e rewrite). Sempre local.
API_URL=http://127.0.0.1:3333
# Mesmo valor do INTERNAL_API_KEY do apps/api (identifica o Next perante a API). Nunca com NEXT_PUBLIC_.
INTERNAL_API_KEY=
# Hospedagens de imagem permitidas, separadas por vírgula (ex.: cdn.exemplo.com)
IMAGE_HOSTS=
# Endereço público do site (links absolutos, canonical)
SITE_URL=http://localhost:3000
# Libera a tela do simulador de pagamento num build de produção (só ambiente de teste; a API também precisa de PAYMENT_DRIVER=fake).
# PAYMENT_SIMULATOR=true
