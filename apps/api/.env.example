# Copie para apps/api/.env
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
DATABASE_URL=postgresql://escola:escola@localhost:5432/escola
# Endereço público do site. Em produção precisa ser https (o cookie de sessão vira Secure sozinho).
WEB_ORIGIN=http://localhost:3000
# Segredo compartilhado com o servidor do Next (gere com: openssl rand -hex 32). Obrigatório em produção.
# INTERNAL_API_KEY=

# --- Pagamento ---
# `fake` = simulador local (padrão fora de produção). Em produção precisa ser `mercadopago`.
PAYMENT_DRIVER=fake
# Com PAYMENT_DRIVER=mercadopago (credenciais do painel "Suas integrações"; use as de TESTE em desenvolvimento):
# MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (painel → Webhooks). Valida o x-signature das notificações.
# MERCADOPAGO_WEBHOOK_SECRET=
# Endereço PÚBLICO https da API (o Mercado Pago chama o webhook aqui). Em desenvolvimento use um túnel.
# API_PUBLIC_URL=
PAYMENT_MAX_INSTALLMENTS=12

# Arquivos enviados (uploads, certificados). Em produção: volume persistente e com backup.
FILES_DIR=./storage
# Segredo das URLs assinadas de arquivos privados (obrigatório em produção): openssl rand -hex 32
# FILES_SIGNING_SECRET=

# Prefixo dos códigos de certificado (marca da plataforma, 2 a 8 letras maiúsculas). Padrão: GAROTO.
# CERTIFICATE_CODE_PREFIX=GAROTO
