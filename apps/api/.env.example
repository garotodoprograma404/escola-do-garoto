# Copie para apps/api/.env
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
DATABASE_URL=postgresql://escola:escola@localhost:5432/escola
# Endereço público do site. Em produção precisa ser https (o cookie de sessão vira Secure sozinho).
WEB_ORIGIN=http://localhost:3000
# Segredo compartilhado com o servidor do Next (gere com: openssl rand -hex 32). Obrigatório em produção.
# INTERNAL_API_KEY=

# --- Pagamento ---
# O Mercado Pago é configurado no painel do admin (Configurações → Financeiro), não aqui. Sem
# credenciais, fora de produção a compra usa o simulador local.

# Arquivos enviados (uploads, certificados). Em produção: volume persistente e com backup.
FILES_DIR=./storage
# Segredo das URLs assinadas de arquivos privados (obrigatório em produção): openssl rand -hex 32
# FILES_SIGNING_SECRET=

# Prefixo dos códigos de certificado (marca da plataforma, 2 a 8 letras maiúsculas). Padrão: GAROTO.
# CERTIFICATE_CODE_PREFIX=GAROTO
