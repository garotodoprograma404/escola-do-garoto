{
  "name": "escola-do-garoto",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vox/contracts --filter @vox/api --filter @vox/web dev",
    "dev:api": "pnpm --filter @vox/api dev",
    "dev:web": "pnpm --filter @vox/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm lint",
    "format": "prettier --write .",
    "db:up": "podman compose -f infra/compose.yaml up -d",
    "db:down": "podman compose -f infra/compose.yaml down",
    "db:generate": "pnpm --filter @vox/api db:generate",
    "db:migrate": "pnpm --filter @vox/api db:migrate",
    "db:studio": "pnpm --filter @vox/api db:studio",
    "postinstall": "pnpm --filter @vox/contracts build",
    "predev": "pnpm --filter @vox/contracts build",
    "prebuild": "pnpm --filter @vox/contracts build",
    "pretypecheck": "pnpm --filter @vox/contracts build",
    "db:seed": "pnpm --filter @vox/api db:seed",
    "db:seed:demo": "pnpm --filter @vox/api db:seed:demo"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "license": "GPL-3.0-only"
}
